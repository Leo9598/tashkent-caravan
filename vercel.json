{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Cache-Control": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0",
        "Pragma": "no-cache",
        "Expires": "0"
      },
      "continue": true
    },
    {
      "src": "/staff(/.*)?",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "/api/site-status",
      "dest": "/api/site-status.js"
    },
    {
      "src": "/api/send-email",
      "dest": "/api/send-email.js"
    },
    {
      "src": "/api/send-telegram",
      "dest": "/api/send-telegram.js"
    },
    {
      "src": "/api/orders",
      "dest": "/api/orders.js"
    },
    {
      "src": "/api/staff/(session|orders|history)",
      "dest": "/api/staff/$1.js"
    },
    {
      "src": "/staff/?",
      "dest": "/staff/index.html"
    },
    {
      "src": "/(server|database|scripts|tests)(/.*)?",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
